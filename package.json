{
  "name": "100-voces",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "build": "python scripts/build.py && node scripts/build-worker.mjs",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "test": "node tests/run.cjs",
    "test:browser": "node tests/run.cjs browser.cjs",
    "test:improvements": "node tests/run.cjs improvements.cjs",
    "test:release": "node tests/run.cjs release.cjs",
    "test:accessibility": "node tests/run.cjs accessibility.cjs",
    "resources": "node scripts/carousel.cjs",
    "package:delivery": "python scripts/package.py",
    "build:content": "python scripts/build.py",
    "test:engines": "node tests/run.cjs engines.cjs",
    "db:local": "node scripts/init-local-db.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "qrcode": "1.5.4",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "22.19.19",
    "axe-core": "4.10.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  },
  "type": "module",
  "description": "100 VOCES",
  "overrides": {
    "esbuild": "$esbuild"
  }
}
